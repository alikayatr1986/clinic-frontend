# Server-only Go API origin, never use NEXT_PUBLIC_ for credentials or API secrets.
API_BASE_URL=http://127.0.0.1:8080
# Reviewed public details only. Empty/invalid details remain hidden.
CONTACT_ADDRESS_EN=
CONTACT_ADDRESS_AR=
# Plain email address and E.164 phone (+ followed by 8–15 digits).
CONTACT_PUBLIC_EMAIL=
CONTACT_PUBLIC_PHONE=
# HTTPS only: https://wa.me/<international digits>, https://t.me/<reviewed username>.
CONTACT_WHATSAPP_URL=
CONTACT_TELEGRAM_URL=
# Optional reviewed country JSON array. If unset, bundled country names are used.
# dialRegion is an optional reviewed ISO 3166-1 alpha-2 phone region. A country
# without one remains selectable for residence but blocks telephone submission.
# Shape: [{"code":"<stable code>","en":"<English label>","ar":"<Arabic label>","dialRegion":"TR"}]
# Codes: 1–100 ASCII letters/digits/_/-, starting with letter/digit; labels 1–200 characters.
# An explicit empty array disables country selection and submission.
# CONTACT_LOCATIONS_JSON=[]
# Public reCAPTCHA v3 site key only (serialized to the browser). Never put a secret here.
CONTACT_CAPTCHA_SITE_KEY=
# Must match backend RECAPTCHA_LEAD_ACTION (example: lead). Empty fails closed.
CONTACT_CAPTCHA_ACTION=

# Optional local-only bypass; requires development mode and a backend with RECAPTCHA_DISABLED=true.
# CONTACT_CAPTCHA_DEV_BYPASS=true
